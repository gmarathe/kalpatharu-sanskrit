{
  // Cloudflare Worker: static files from public/ + a small API at /api/*.
  // Only /api/* runs Worker code (run_worker_first); pages, fonts and the app
  // itself are served as static assets and use none of the Worker request quota.
  "name": "kalpatharu-sanskrit",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // ಪ್ರಗತಿ ಉಳಿಸುವ ಡೇಟಾಬೇಸ್. ಮೊದಲ deploy ನಲ್ಲಿ Cloudflare ತಾನಾಗಿ ಸೃಷ್ಟಿಸುತ್ತದೆ
  // (wrangler 4.45+). ಕೋಷ್ಟಕಗಳನ್ನು Worker ಮೊದಲ ಕರೆಯಲ್ಲೇ ಸೃಷ್ಟಿಸುತ್ತದೆ.
  "d1_databases": [{ "binding": "DB", "database_name": "kalpatharu-sanskrit", "database_id": "e6ef673e-1789-45b3-9b58-c73f1ffc76ee" }],
  "vars": {
    // Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
    // ಇದು ರಹಸ್ಯವಲ್ಲ. ಖಾಲಿ ಇದ್ದರೆ ಆ್ಯಪ್‌ನಲ್ಲಿ ಲಾಗಿನ್ ಕಾರ್ಡ್ ಕಾಣಿಸುವುದಿಲ್ಲ.
    "GOOGLE_CLIENT_ID": "948794395364-rh4a3bjhictvtdnip9misj37o7u48798.apps.googleusercontent.com",
    // ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ (/admin) ತೆರೆಯಬಲ್ಲ Google ಖಾತೆಗಳು — ಅಲ್ಪವಿರಾಮದಿಂದ ಬೇರ್ಪಡಿಸಿ
    "ADMIN_EMAILS": "gmujire@gmail.com"
  },
  // ಪರೀಕ್ಷಾ (preview) ಆವೃತ್ತಿಗಳು: ಪ್ರತ್ಯೇಕ ಡೇಟಾಬೇಸ್ — ನಿಜವಾದ ಸದಸ್ಯರ ಪ್ರಗತಿ ಮುಟ್ಟುವುದಿಲ್ಲ.
  "previews": {
    "vars": { "GOOGLE_CLIENT_ID": "", "ADMIN_EMAILS": "" },
    "d1_databases": [{ "binding": "DB", "database_name": "kalpatharu-sanskrit-preview" }]
  },
  "observability": { "enabled": true }
  // ಡೊಮೈನ್: ksm.kalpatharu.org (Worker → Settings → Domains & Routes)
}
