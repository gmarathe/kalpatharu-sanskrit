{
  // Cloudflare Worker — static files only (no server code, so it uses
  // none of the account's daily Worker request quota).
  "name": "kalpatharu-sanskrit",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
  // ಡೊಮೈನ್ ಜೋಡಿಸಲು: Cloudflare ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ → ಈ Worker → Settings →
  // Domains & Routes → Add → Custom domain → ksm.kalpatharu.org
}
